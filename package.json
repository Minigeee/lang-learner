{
  "name": "lang-learner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm content:check",
    "typecheck": "pnpm -r typecheck",
    "lint": "depcruise apps packages languages scripts && node scripts/check-core-cjk.mjs",
    "test": "pnpm -r test",
    "content:check": "node packages/content-tools/cli.ts check",
    "content:build": "node packages/content-tools/cli.ts build",
    "content:suggest": "node packages/content-tools/cli.ts suggest",
    "start": "node apps/server/main.ts --web apps/web/dist"
  },
  "devDependencies": {
    "dependency-cruiser": "18.7.2",
    "typescript": "6.0.3"
  }
}
