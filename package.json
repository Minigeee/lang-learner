{
  "name": "lang-learner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm --filter @lang-learner/web dev",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "pnpm -r typecheck",
    "lint": "depcruise apps packages languages scripts && node scripts/check-core-cjk.mjs",
    "test": "pnpm -r test",
    "test:db": "pnpm --filter @lang-learner/web test:db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && supabase seed buckets --local",
    "db:owner": "node scripts/create-owner.mjs",
    "dev:env": "node scripts/write-web-env.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "18.7.2",
    "supabase": "3.0.0",
    "typescript": "6.0.3"
  }
}
